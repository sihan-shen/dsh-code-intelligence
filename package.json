{
  "name": "@ds-plugins/dsh-code-intelligence",
  "version": "0.2.0",
  "description": "Repository snapshots, symbols, and context tools for DeepSeek Harness",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "type": "module",
  "main": "./lib/index.mjs",
  "types": "./lib/index.d.mts",
  "exports": {
    ".": {
      "types": "./lib/index.d.mts",
      "default": "./lib/index.mjs"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.mjs",
    "lib/index.d.mts",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown --out-dir lib --external typescript",
    "prepare": "pnpm run build",
    "prepack": "pnpm run build",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:package-entry": "pnpm run build && pnpm exec vitest run tests/package-entry.spec.ts"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-subprocess": "0.1.1-rc.2",
    "@ds-plugins/dsh-context": "git+https://github.com/sihan-shen/DS-Plugins.git#d5d1caa61bf8e38d8b9946176bf02b63545aca9c&path:/packages/dsh-context",
    "@ds-plugins/dsh-context-cache": "git+https://github.com/sihan-shen/DS-Plugins.git#d5d1caa61bf8e38d8b9946176bf02b63545aca9c&path:/packages/dsh-context-cache",
    "picomatch": "4.0.7",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@types/node": "26.3.0",
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2",
    "@deepseek-ai/dsh-storage": "0.1.1-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@deepseek-ai/dsh-workspace": "0.1.1-rc.2",
    "typescript": "5.9.3",
    "tsdown": "0.18.0",
    "vitest": "4.0.18"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2"
  }
}
