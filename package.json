{
  "name": "@han_05/dsh-code-intelligence",
  "version": "0.3.0-rc.1",
  "description": "Repository snapshots, symbols, and context tools for DeepSeek Harness",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sihan-shen/dsh-code-intelligence.git"
  },
  "homepage": "https://github.com/sihan-shen/dsh-code-intelligence#readme",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/index.js.map",
    "lib/index.d.ts",
    "lib/index.d.ts.map",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown --config tsdown.config.ts",
    "prepare": "pnpm run build",
    "prepack": "pnpm run build",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:package-entry": "pnpm run build && pnpm run test:package-entry:built",
    "test:package-entry:built": "pnpm exec vitest run tests/package-entry.spec.ts"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@han_05/dsh-context": "0.3.0-rc.1",
    "@han_05/dsh-context-cache": "0.3.0-rc.1",
    "picomatch": "4.0.7",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-subprocess": "0.1.2-rc.1",
    "@deepseek-ai/schemastery": "3.18.2",
    "@deepseek-ai/dsh-client-locale": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session": "0.1.2-rc.1",
    "@deepseek-ai/dsh-settings": "0.1.2-rc.1",
    "@deepseek-ai/dsh-storage": "0.1.2-rc.1",
    "@deepseek-ai/dsh-storage-domain": "0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.2-rc.1",
    "@deepseek-ai/dsh-workspace": "0.1.2-rc.1",
    "@types/node": "26.3.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "tsdown": "0.18.0",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-llm": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session": "0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.2-rc.1",
    "@deepseek-ai/dsh-workspace": "0.1.2-rc.1",
    "@deepseek-ai/schemastery": "3.18.2",
    "@deepseek-ai/dsh-client-locale": ">=0.1.2-rc.1 <0.1.3",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.2-rc.1 <0.1.3",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.2-rc.1 <0.1.3",
    "@deepseek-ai/dsh-settings": ">=0.1.2-rc.1 <0.1.3",
    "@deepseek-ai/dsh-subprocess": ">=0.1.2-rc.1 <0.1.3",
    "react": ">=18.2.0 <19.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-subprocess": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  }
}
